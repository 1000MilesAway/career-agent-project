.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# личные данные прогона и результаты — в репо не кладём.
# Исключаем содержимое, а не сам каталог: git не заглядывает внутрь
# исключённого каталога, и тогда ни одно "!" ниже до файла не дотянется.
data/*
out/

# ...кроме списков источников. Это данные, а не личное: публичные имена
# каналов с отметками ручной проверки. Продукт без них не ищет вообще, и в
# CI их отсутствие валило тесты с пустым списком вместо внятной причины.
# data/resumes и data/golden остаются закрытыми — там чужие тексты.
!data/sources/

# worktree-каталоги агента: в репозитории им не место
.claude/worktrees/

# Фронтенд: зависимости и сборка. Бандл собирается в образе (frontend/Dockerfile),
# и коммит собранного dist означал бы диффы на тысячи строк при каждой правке CSS.
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Скриншоты и логи Playwright MCP — артефакты проверки в браузере, не исходники.
.playwright-mcp/
