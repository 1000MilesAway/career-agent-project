{
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run ruff check *)",
      "Bash(uv run python -m app.cli calibrate *)",
      "Bash(scripts/check.sh)",
      "Bash(scripts/quick-check.sh)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(curl -s http://82.25.161.103:8000/api/health)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
