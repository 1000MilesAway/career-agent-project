# LLM. Model names below are what the live key actually serves —
# `deepseek-chat` from the public docs is not available on it.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Steps served through OpenRouter instead (an id with a "/" is an OpenRouter
# model). Without the key every step stays on DeepSeek. The default routes cover
# letters to Haiku; an empty LLM_STEP_MODELS routes nothing.
OPENROUTER_API_KEY=sk-or-...
# LLM_STEP_MODELS=cover_letter=anthropic/claude-haiku-5.5
# The owner's accounting only: users never see money.
# USD_RUB=83.56

# Quotas per plan, USD at the off-peak price; 0 switches a window off (a
# laptop). Defaults are the decided ones — see docs/decisions.md, 2026-10-01.
# FREE_DAY_USD=0.04
# FREE_WEEK_USD=0.12
# PAID_DAY_USD=0.10
# PAID_WEEK_USD=0.30

# hh.ru through the hh-scrapper provider on another host: hh answers 403 to
# this server, and serves its HTML there. Either value empty = the source is
# off and a scan of everything skips it. The token is the provider's
# HH_SCRAPPER_TOKEN.
HH_PROVIDER_URL=
HH_PROVIDER_TOKEN=

# Telegram chats through the tg-provider userbot on the same host (port 8091).
# Either value empty = the "telethon" source is off. The token is the
# provider's TG_PROVIDER_TOKEN.
TG_PROVIDER_URL=
TG_PROVIDER_TOKEN=

# Database. Port 5433 matches compose.yml, which keeps off 5432 so a system
# Postgres does not collide with the container.
DATABASE_URL=postgresql+asyncpg://career:career@localhost:5433/career

# JWT signing key. Generate a real one per install:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out, which is the intended way to revoke sessions
# while there is no token store.
SECRET_KEY=change-me
# How long a login lasts. No refresh tokens in the MVP: there is no email, so
# a stolen token cannot be reported and a short-ish window is the only limit.
ACCESS_TOKEN_HOURS=72

# Telegram Login (OIDC): log in with a Telegram account linked in the cabinet.
# The client id is the bot id, taken from the token; empty token = off, and no
# button is shown. The site URL must be in the bot's Allowed URLs in @BotFather
# (bot -> Login Widget), or Telegram refuses the popup.
TELEGRAM_BOT_TOKEN=
# Only if @BotFather shows a Client ID different from the bot id.
# TELEGRAM_CLIENT_ID=

# Email via Resend: for now only the letter that confirms a self-signup.
# Either value empty = signing up by email is off. MAIL_FROM must be on a
# domain verified in Resend, or letters reach only the Resend account owner.
RESEND_API_KEY=
# MAIL_FROM=career-agent <noreply@mail.gethire.ru>
# Where links in letters point: the cabinet, not the API.
# PUBLIC_URL=https://gethire.ru

# Payments via Platega: MerchantId and API key from the dashboard (Настройки).
# Either empty = the cabinet shows the plans but cannot take payment. In the
# dashboard set the callback URL to {PUBLIC_URL}/api/billing/callback.
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# PRO_PRICE_RUB=400
# PRO_DAYS=30

# GIT_SHA is deliberately NOT listed here, and must not be added to a real
# .env. deploy.sh passes it per run, and compose falls back to whatever .env
# holds when the variable is unset — so a sha written here would be served by
# /api/health forever, reporting an old revision as the running one. That is
# the exact failure the field exists to catch.
